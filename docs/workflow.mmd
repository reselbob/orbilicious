flowchart LR
    Start([Start]) --> Mode{Session<br>mode?}
    Mode -->|EMULATION| Em[Emulator]
    Mode -->|PAPER/LIVE| Live[LiveTrader]
    Em & Live --> Reset["Reset daily risk budget<br>(cumulativeRealizedLoss = 0)"]
    Reset --> Scan

    subgraph Scan ["1. Symbol Scan"]
        direction TB
        Fetch["Fetch most active stocks<br>(4x desired, cap 100)"] --> Price["Filter: price >= $1"]
        Price --> Top["Keep top QUANTITY_TO_RETRIEVE<br>(default 30)"]
        Top --> Bars["Get 1-min intraday bars<br>from Alpaca REST"]
    end

    Scan --> OR

    subgraph OR ["2. Opening Range"]
        direction TB
        CompOR["Compute OR high/low<br>from first 15 bars<br>(09:31-09:45 ET)"] --> EmitOR["Emit OR status"]
    end

    OR --> BD

    subgraph BD ["3. Breakout Determination (09:31-09:46 ET)"]
        direction TB
        ForEach["For each symbol:"] --> BC{Breakout bar closes<br>outside OR range?}
        BC -->|No| Reject[Reject]
        BC -->|Yes| Retest{Retest within<br>max age?}
        Retest -->|No| Reject
        Retest -->|Yes| QFDefault["Quality filters ON by default<br>(MinVol 1.5, RelStr 0.50%,<br>ATR stop 1.5, MinStop 1.25%)"]
        QFDefault --> QF{Passes quality<br>filters?}
        QF -->|No| Reject
        QF -->|Yes| Score["Score candidate"]
        Reject --> ForEach
        Score --> DoneBD["Done"]
    end

    BD --> TS

    subgraph TS ["4. Trade Sizing"]
        direction TB
        Rank["Rank by score,<br>separate L/S"] --> Select["Top MAX_POSITIONS_PER_SIDE<br>per side (default 2)"]
        Select --> Risk["Compute remaining risk<br>(maxTotalRisk - usedRisk)<br>MAX_TOTAL_RISK resets daily"]
        Risk --> Check{Remaining<br>risk > 0?}
        Check -->|No| Stop[Stop]
        Check -->|Yes| Weight["Weighted risk by score<br>3R profit target (1:3 ratio)"]
        Weight --> Norm["Normalize to notional,<br>buying power, qty floor"]
    end

    TS --> TE

    subgraph TE ["5. Trade Execution"]
        direction TB
        Dedup["Dedup check"] --> ITE{ITrader<br>dispatch}
        ITE -->|Emulator| Dry["Log dry-run entry<br>Add to simulatedPositions Map"]
        ITE -->|LiveTrader| Order["Submit bracket order<br>(entry, stop, target)<br>via Alpaca API"]
    end

    TE --> PM

    subgraph PM ["6. Position Monitoring"]
        direction TB
        Poll["Poll every 20s"] --> FE{Force-exit<br>time?}
        FE -->|Yes| FC["ITrader.managePosition<br>closes at favorable<br>price or market"]
        FE -->|No| Broker{Stop/target<br>hit?}
        Broker -->|Yes| Done[Closed]
        Broker -->|No| Poll
        FC --> Done
    end

    PM --> EOD

    subgraph EOD ["7. End of Day"]
        direction TB
        MC{Market<br>closed?} -->|Yes| Report["Generate ORB report"]
        MC -->|No| PM
    end

    EOD --> End([Session Complete])
