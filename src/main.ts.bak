import { env, strategyConfig } from './config.js';
import { AlpacaClient } from './alpaca.js';
import { logger } from './logger.js';
import { computeOpeningRange, generateOrbSignal } from './strategy.js';
import { sleep, todayNyDate } from './time.js';
import { Bar } from './types.js';

type BreakoutCandidate = {
  symbol: string;
  side: 'buy' | 'sell';
  price: number;
  reason: string;
  score: number;
  relativeBreakPct: number;
  totalVolume: number;
  openingRangeHigh: number;
  openingRangeLow: number;
};

type SizedTrade = BreakoutCandidate & {
  assignedRiskDollars: number;
  stopPrice: number;
  stopDistancePerShare: number;
  takeProfitPrice: number;
  qty: number;
  plannedRiskDollars: number;
  estimatedNotional: number;
};

const executedToday = new Set<string>();
const MIN_QTY = 0.0001;
const MIN_SCORE = 0.0000001;

function executionKey(sessionDate: string, symbol: string) {
  return `${sessionDate}:${symbol}`;
}

function sumVolume(bars: Bar[]): number {
  return bars.reduce((sum, bar) => sum + bar.volume, 0);
}

function computeCandidateScore(params: {
  bars: Bar[];
  breakoutSide: 'buy' | 'sell';
  latestClose: number;
  openingRangeHigh: number;
  openingRangeLow: number;
}): {
  score: number;
  relativeBreakPct: number;
  totalVolume: number;
} {
  const { bars, breakoutSide, latestClose, openingRangeHigh, openingRangeLow } = params;

  const totalVolume = sumVolume(bars);
  const breakoutReference = breakoutSide === 'buy' ? openingRangeHigh : openingRangeLow;
  const relativeBreakPct =
    Math.abs((latestClose - breakoutReference) / breakoutReference) * 100;

  const volumeScore = Math.log10(Math.max(totalVolume, 1));
  const score = relativeBreakPct * volumeScore;

  return {
    score,
    relativeBreakPct,
    totalVolume,
  };
}

async function evaluateSymbol(
  client: AlpacaClient,
  symbol: string,
  sessionDate: string
): Promise<BreakoutCandidate | null> {
  try {
    const position = await client.getOpenPosition(symbol);
    if (position) {
      logger.debug('Skipping symbol with existing position', { symbol, position });
      return null;
    }

    if (executedToday.has(executionKey(sessionDate, symbol))) {
      logger.debug('Skipping symbol already executed today', { symbol, sessionDate });
      return null;
    }

    const bars = await client.getIntradayBars(symbol, sessionDate);
    if (!bars.length) {
      logger.debug('Skipping symbol with no bars', { symbol, sessionDate });
      return null;
    }

    const cfg = { ...strategyConfig, symbol };
    const openingRange = computeOpeningRange(bars, sessionDate, cfg);

    const signal = generateOrbSignal({
      bars,
      openingRange,
      existingPosition: null,
      cfg,
    });

    const latestBar = bars[bars.length - 1];
    if (!latestBar) return null;

    if (signal.type === 'BUY') {
      const metrics = computeCandidateScore({
        bars,
        breakoutSide: 'buy',
        latestClose: latestBar.close,
        openingRangeHigh: openingRange.high,
        openingRangeLow: openingRange.low,
      });

      const candidate = {
        symbol,
        side: 'buy' as const,
        price: signal.price,
        reason: signal.reason,
        score: metrics.score,
        relativeBreakPct: metrics.relativeBreakPct,
        totalVolume: metrics.totalVolume,
        openingRangeHigh: openingRange.high,
        openingRangeLow: openingRange.low,
      };

      logger.info('Long breakout candidate identified', candidate);
      return candidate;
    }

    if (signal.type === 'SELL') {
      const metrics = computeCandidateScore({
        bars,
        breakoutSide: 'sell',
        latestClose: latestBar.close,
        openingRangeHigh: openingRange.high,
        openingRangeLow: openingRange.low,
      });

      const candidate = {
        symbol,
        side: 'sell' as const,
        price: signal.price,
        reason: signal.reason,
        score: metrics.score,
        relativeBreakPct: metrics.relativeBreakPct,
        totalVolume: metrics.totalVolume,
        openingRangeHigh: openingRange.high,
        openingRangeLow: openingRange.low,
      };

      logger.info('Short breakout candidate identified', candidate);
      return candidate;
    }

    logger.debug('Symbol did not qualify as breakout candidate', {
      symbol,
      signal,
    });
    return null;
  } catch (error) {
    logger.error('Failed evaluating symbol', { symbol, sessionDate, error });
    return null;
  }
}

async function findBreakoutCandidates(
  client: AlpacaClient,
  sessionDate: string
): Promise<BreakoutCandidate[]> {
  const symbols = await client.getMostActiveSymbols(40);
  logger.info('Evaluating most active symbols', { sessionDate, symbols });

  const results = await Promise.all(
    symbols.map((symbol) => evaluateSymbol(client, symbol, sessionDate))
  );

  const candidates = results.filter((x): x is BreakoutCandidate => x !== null);
  logger.info('Finished candidate scan', { sessionDate, candidateCount: candidates.length });

  return candidates;
}

function rankAndSelectCandidates(candidates: BreakoutCandidate[]) {
  const longs = candidates
    .filter((c) => c.side === 'buy')
    .sort((a, b) => b.score - a.score)
    .slice(0, 10);

  const shorts = candidates
    .filter((c) => c.side === 'sell')
    .sort((a, b) => b.score - a.score)
    .slice(0, 10);

  logger.info('Ranked and selected candidates', {
    longCount: longs.length,
    shortCount: shorts.length,
    longs: longs.map((c) => ({ symbol: c.symbol, score: c.score })),
    shorts: shorts.map((c) => ({ symbol: c.symbol, score: c.score })),
  });

  return { longs, shorts };
}

function buildWeightedRiskTrades(
  candidates: BreakoutCandidate[],
  maxTotalRisk: number
): SizedTrade[] {
  const positiveScoreCandidates = candidates.filter((c) => c.score > MIN_SCORE);
  if (!positiveScoreCandidates.length) {
    logger.warn('No positive-score candidates available for weighted risk sizing');
    return [];
  }

  const totalScore = positiveScoreCandidates.reduce((sum, c) => sum + c.score, 0);
  if (totalScore <= 0) {
    logger.warn('Total score for candidate basket is non-positive', { totalScore });
    return [];
  }

  const trades = positiveScoreCandidates
    .map((candidate) => {
      const assignedRiskDollars = maxTotalRisk * (candidate.score / totalScore);

      const stopPrice =
        candidate.side === 'buy'
          ? candidate.openingRangeLow
          : candidate.openingRangeHigh;

      const stopDistancePerShare = Math.abs(candidate.price - stopPrice);
      if (stopDistancePerShare <= 0) {
        logger.warn('Skipping candidate with invalid stop distance', { candidate });
        return null;
      }

      const qty = assignedRiskDollars / stopDistancePerShare;
      if (qty < MIN_QTY) {
        logger.warn('Skipping candidate with too-small quantity', {
          symbol: candidate.symbol,
          qty,
          assignedRiskDollars,
          stopDistancePerShare,
        });
        return null;
      }

      const takeProfitPrice =
        candidate.side === 'buy'
          ? candidate.price + 4 * stopDistancePerShare
          : candidate.price - 4 * stopDistancePerShare;

      const plannedRiskDollars = qty * stopDistancePerShare;
      const estimatedNotional = qty * candidate.price;

      return {
        ...candidate,
        assignedRiskDollars,
        stopPrice,
        stopDistancePerShare,
        takeProfitPrice,
        qty,
        plannedRiskDollars,
        estimatedNotional,
      };
    })
    .filter((x): x is SizedTrade => x !== null);

  logger.info('Built weighted-risk trades', {
    tradeCount: trades.length,
    maxTotalRisk,
    trades: trades.map((t) => ({
      symbol: t.symbol,
      assignedRiskDollars: t.assignedRiskDollars,
      qty: t.qty,
      estimatedNotional: t.estimatedNotional,
    })),
  });

  return trades;
}

function normalizeTradesToConstraints(
  trades: SizedTrade[],
  maxTotalRisk: number,
  availableBuyingPower: number
): SizedTrade[] {
  if (!trades.length) {
    logger.warn('No trades available for normalization');
    return [];
  }

  const totalPlannedRisk = trades.reduce((sum, t) => sum + t.plannedRiskDollars, 0);
  const totalEstimatedNotional = trades.reduce((sum, t) => sum + t.estimatedNotional, 0);

  if (totalPlannedRisk <= 0 || totalEstimatedNotional <= 0) {
    logger.warn('Invalid basket totals before normalization', {
      totalPlannedRisk,
      totalEstimatedNotional,
    });
    return [];
  }

  const riskScale = maxTotalRisk / totalPlannedRisk;
  const buyingPowerScale = availableBuyingPower / totalEstimatedNotional;
  const finalScale = Math.min(1, riskScale, buyingPowerScale);

  logger.info('Normalizing basket to constraints', {
    maxTotalRisk,
    availableBuyingPower,
    totalPlannedRisk,
    totalEstimatedNotional,
    riskScale,
    buyingPowerScale,
    finalScale,
  });

  const normalized = trades
    .map((trade) => {
      const scaledQty = trade.qty * finalScale;
      if (scaledQty < MIN_QTY) {
        logger.warn('Dropping normalized trade with too-small quantity', {
          symbol: trade.symbol,
          scaledQty,
        });
        return null;
      }

      const roundedQty = Number(scaledQty.toFixed(4));
      const plannedRiskDollars = roundedQty * trade.stopDistancePerShare;
      const estimatedNotional = roundedQty * trade.price;

      return {
        ...trade,
        qty: roundedQty,
        assignedRiskDollars: plannedRiskDollars,
        plannedRiskDollars,
        estimatedNotional,
      };
    })
    .filter((x): x is SizedTrade => x !== null);

  logger.info('Completed basket normalization', {
    tradeCount: normalized.length,
    normalizedTotalRisk: normalized.reduce((sum, t) => sum + t.plannedRiskDollars, 0),
    normalizedTotalNotional: normalized.reduce((sum, t) => sum + t.estimatedNotional, 0),
  });

  return normalized;
}

async function executeSizedTrades(
  client: AlpacaClient,
  sessionDate: string,
  trades: SizedTrade[]
) {
  const totalPlannedRisk = trades.reduce((sum, t) => sum + t.plannedRiskDollars, 0);
  const totalEstimatedNotional = trades.reduce((sum, t) => sum + t.estimatedNotional, 0);

  logger.info('Submitting normalized trade basket', {
    sessionDate,
    tradeCount: trades.length,
    totalPlannedRisk,
    totalEstimatedNotional,
  });

  for (const trade of trades) {
    const key = executionKey(sessionDate, trade.symbol);

    if (executedToday.has(key)) {
      logger.warn('Skipping already executed trade', { symbol: trade.symbol, sessionDate });
      continue;
    }

    try {
      await client.submitBracketOrder({
        symbol: trade.symbol,
        side: trade.side,
        qty: trade.qty,
        takeProfitLimitPrice: trade.takeProfitPrice,
        stopLossStopPrice: trade.stopPrice,
      });

      executedToday.add(key);

      logger.info('Trade submitted successfully', {
        symbol: trade.symbol,
        side: trade.side,
        qty: trade.qty,
        entry: trade.price,
        stop: trade.stopPrice,
        target: trade.takeProfitPrice,
        plannedRisk: trade.plannedRiskDollars,
        estimatedNotional: trade.estimatedNotional,
      });
    } catch (error) {
      logger.error('Trade submission failed', {
        symbol: trade.symbol,
        sessionDate,
        error,
      });
    }
  }
}

async function runCycle(client: AlpacaClient, sessionDate: string) {
  logger.info('Starting run cycle', { sessionDate });

  const account = await client.getAccount();

  if (account.tradingBlocked) {
    logger.warn('Trading is blocked on account', { sessionDate });
    return;
  }

  const candidates = await findBreakoutCandidates(client, sessionDate);
  const { longs, shorts } = rankAndSelectCandidates(candidates);
  const selected = [...longs, ...shorts];

  const weightedTrades = buildWeightedRiskTrades(selected, env.maxTotalRisk);
  const normalizedTrades = normalizeTradesToConstraints(
    weightedTrades,
    env.maxTotalRisk,
    account.buyingPower
  );

  logger.info('Cycle summary', {
    sessionDate,
    accountBuyingPower: account.buyingPower,
    candidateCount: candidates.length,
    selectedCount: selected.length,
    weightedTradeCount: weightedTrades.length,
    normalizedTradeCount: normalizedTrades.length,
  });

  await executeSizedTrades(client, sessionDate, normalizedTrades);
  logger.info('Completed run cycle', { sessionDate });
}

async function main() {
  const sessionDate = env.sessionDate || todayNyDate();
  const client = new AlpacaClient();

  logger.info('Starting ORB normalized weighted-risk runner', {
    sessionDate,
    pollIntervalSeconds: env.pollIntervalSeconds,
    maxTotalRisk: env.maxTotalRisk,
    selectionMode: 'top 10 longs and top 10 shorts',
    rewardMode: '4R target',
  });

  for (; ;) {
    try {
      await runCycle(client, sessionDate);
    } catch (error) {
      logger.error('Unhandled cycle failure', { sessionDate, error });
    }

    await sleep(env.pollIntervalSeconds * 1000);
  }
}

main().catch((error) => {
  logger.error('Fatal application error', { error });
  process.exit(1);
});