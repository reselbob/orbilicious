# Enables long-side breakout entries.
ALLOW_LONG=true

# Enables short-side breakout entries.
ALLOW_SHORT=true

# Base URL for Alpaca market data requests.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Alpaca market data feed to use: iex works broadly but may be delayed; sip requires the proper Alpaca entitlement for real-time consolidated data.
ALPACA_DATA_FEED=iex

# Base URL for Alpaca WebSocket streaming endpoint. The feed (iex/sip) is appended as /v2/{feed}.
ALPACA_WS_BASE_URL=wss://stream.data.alpaca.markets

# Base URL for Alpaca trading and account requests.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# Alpaca API key ID; leave blank and provide your own credential.
APCA_API_KEY_ID=

# Alpaca API secret key; leave blank and provide your own credential.
APCA_API_SECRET_KEY=

# ATR multiplier used when deriving fallback stop distance.
ATR_STOP_MULTIPLE=1

# Candle interval in minutes for intraday bars.
CANDLE_MINUTES=1

# New York time after which end-of-day profit-capture logic can close positions.
FORCE_EXIT_TIME=15:55

# Maximum total notional dollars allowed across the basket.
HARD_BASKET_CAP=25000

# Last New York time when new entries are allowed.
LAST_ENTRY_TIME=15:30

# Winston logging verbosity for the app.
LOG_LEVEL=debug

# Maximum selected breakout candidates per side after ranking.
MAX_POSITIONS_PER_SIDE=3

# Maximum notional dollars allowed for a single position before basket scaling.
MAX_POSITION_NOTIONAL=5000

# Maximum total planned stop-loss risk in dollars for the session.
MAX_TOTAL_RISK=1000

# Minimum stop distance as a fraction of entry price.
MIN_STOP_PCT=0.0075

# Node runtime environment name.
NODE_ENV=development

# Number of minutes used to build the opening range.
OPENING_RANGE_MINUTES=15

# Seconds to wait between live polling cycles.
POLL_INTERVAL_SECONDS=20

# Baseline strategy quantity setting retained for config completeness.
QTY=1

# Number of most-active symbols to retrieve for candidate scanning.
QUANTITY_TO_RETRIEVE=40

# Candle size (minutes) used to confirm the breakout close outside the opening range.
BREAKOUT_CONFIRMATION_CANDLE_MINUTES=5

# Maximum age (minutes) allowed between confirmation retest and entry consideration for the current NY session. Set 0 to disable staleness filtering.
BREAKOUT_RETEST_MAX_AGE_MINUTES=1

# Enables breakout quality gating (volume expansion, relative strength/weakness, and trend alignment).
BREAKOUT_QUALITY_FILTERS_ENABLED=false

# Minimum breakout-candle volume expansion ratio versus prior confirmation candles.
BREAKOUT_MIN_VOLUME_EXPANSION=1.2

# Minimum percentage close outside the opening-range boundary for breakout strength.
BREAKOUT_MIN_RELATIVE_STRENGTH_PCT=0.25

# Higher-timeframe candle size (minutes) used for trend alignment checks.
BREAKOUT_TREND_TIMEFRAME_MINUTES=5

# Number of higher-timeframe bars used to evaluate trend alignment before breakout.
BREAKOUT_TREND_LOOKBACK_BARS=3

# Historical emulation anchor date in YYYY-MM-DD format; leave blank for current-day mode.
SESSION_DATE=2026-05-14

# Execution mode: EMULATION uses live data with no orders, PAPER uses paper trading, LIVE sends real orders.
SESSION_MODE=EMULATION

# Risk-to-reward ratio expressed as risk:reward.
STOP_LOSS_PROFIT_RATIO=1:4

# Baseline symbol used by some reporting and opening-range UI status logic.
SYMBOL=SPY